{
  "name": "claude-electron",
  "productName": "POWER-AGENT",
  "version": "1.3.0",
  "main": "main.js",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dev:trace": "ELECTRON_ENABLE_LOGGING=1 ELECTRON_ENABLE_STACK_DUMPING=1 electron .",
    "postinstall": "electron-rebuild -f -w node-pty || true",
    "build:voice-helper": "bash ./scripts/build-voice-helper.sh",
    "prebuild:zip": "npm run build:voice-helper",
    "prebuild:dmg": "npm run build:voice-helper",
    "predist": "npm run build:voice-helper",
    "predist:signed": "npm run build:voice-helper",
    "predist:unsigned": "npm run build:voice-helper",
    "dist": "electron-builder --mac --arm64 --x64",
    "dist:signed": "electron-builder --mac --arm64 --x64",
    "dist:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --x64",
    "build:zip": "electron-builder --mac zip --arm64 --x64",
    "build:dmg": "electron-builder --mac dmg --arm64 --x64",
    "doctor": "bash ./scripts/doctor.sh",
    "reset:state": "bash ./scripts/reset-macos-state.sh",
    "deploy": "bash ./scripts/deploy.sh",
    "wa:send": "bash ./scripts/whatsapp-send-safe.sh",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "cron-parser": "^4.9.0",
    "d3": "^7.9.0",
    "electron-updater": "^6.6.2",
    "node-cron": "^4.6.0",
    "node-pty": "^1.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.luismi.claude-novak",
    "productName": "POWER-AGENT",
    "afterSign": "build/notarize.js",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "main.js",
      "telegram-bridge.js",
      "preload.js",
      "renderer.js",
      "project-picker.js",
      "voice-ui-state.js",
      "index.html",
      "lan-client.html",
      "styles.css",
      "viewer.html",
      "viewer-renderer.js",
      "viewer-preload.js",
      "graph-renderer.js",
      "graph-window.html",
      "graph-window-preload.js",
      "graph-window-renderer.js",
      "whatsapp-window.html",
      "whatsapp-window-preload.js",
      "whatsapp/**/*",
      "assets/**/*",
      "headless-runners.js",
      "tasks-manager.html",
      "tasks-manager-renderer.js",
      "tasks-manager-preload.js",
      "bitacora-window.html",
      "bitacora-window-renderer.js",
      "bitacora-window-preload.js",
      "automation-chat.html",
      "automation-chat-renderer.js",
      "automation-chat-preload.js",
      "automation-pty.html",
      "automation-pty-renderer.js",
      "automation-pty-preload.js",
      "task-session.html",
      "task-session-renderer.js",
      "task-session-preload.js",
      "scheduler/**/*",
      "automations/**/*",
      "tasks/**/*",
      "main/**/*",
      "vendor/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      { "from": "resources/voice-helper", "to": "voice-helper" }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "POWER-AGENT usa el micrófono para hablar con el agente.",
        "NSSpeechRecognitionUsageDescription": "POWER-AGENT transcribe tu voz para enviársela al agente.",
        "NSApplicationSupportsSecureRestorableState": true
      }
    },
    "publish": {
      "provider": "github",
      "owner": "aprelmah",
      "repo": "claude-electron"
    },
    "directories": {
      "output": "dist"
    }
  }
}
